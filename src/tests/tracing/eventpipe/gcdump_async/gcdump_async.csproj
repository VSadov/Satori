<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RequiresProcessIsolation>true</RequiresProcessIsolation>
    <TargetFrameworkIdentifier>.NETCoreApp</TargetFrameworkIdentifier>
    <UnloadabilityIncompatible>true</UnloadabilityIncompatible>
    <GCStressIncompatible>true</GCStressIncompatible>
    <DisableProjectBuild Condition="'$(RuntimeFlavor)' == 'mono'">true</DisableProjectBuild>
  </PropertyGroup>
  <ItemGroup>
    <!-- The managed stress check runs after this setting; project-level checks run before it on .NET 10. -->
    <CLRTestEnvironmentVariable Include="DOTNET_TieredCompilation" Value="0" />
    <Compile Include="$(MSBuildProjectName).cs" />
    <Compile Include="../common/HeapDumpGcTrackerTests.cs" Link="HeapDumpGcTrackerTests.cs" />
    <ProjectReference Include="../common/eventpipe_common.csproj" />
    <ProjectReference Include="../common/Microsoft.Diagnostics.NETCore.Client/Microsoft.Diagnostics.NETCore.Client.csproj" />
    <ProjectReference Include="$(TestLibraryProjectPath)" />
  </ItemGroup>
</Project>
